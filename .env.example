# Repository settings
REPO_URLS=
REPO_LOCAL_PATH=./data/repos

# LLM settings
# LLM provider: 'ollama' (default) or 'openai-compat' (for LM Studio, llama.cpp, vLLM, Jan)
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=sam860/LFM2:350m
# For OpenAI-compatible backends (LM Studio, llama.cpp, vLLM, Jan):
# When running the app in Docker (make services-start), the server runs on your host
# machine, not in the container, so "localhost" here means the container itself and
# generation will fail with connection refused. Use host.docker.internal instead.
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_API_KEY=  # Optional, some servers don't require it
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
OLLAMA_NUM_CTX=8192

# Retriever the HTTP API serves search and answer requests from: 'bm25' (default) or 'hybrid'
# RETRIEVER=bm25

# Vector database settings (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=documents

# Chat storage settings
CHAT_STORAGE_PATH=./data/chat_history.db

# Langfuse tracing (optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Application settings
LOG_LEVEL=INFO
