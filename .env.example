# Repository settings
REPO_URLS=
REPO_LOCAL_PATH=./data/repos

# LLM settings
# LLM provider: 'ollama' (default) or 'openai-compat' (for LM Studio, llama.cpp, vLLM, Jan)
# LLM_PROVIDER=ollama
# On macOS "localhost" resolves to ::1 before 127.0.0.1, which can silently
# reach a different server than the one you expect; use the literal IPv4
# loopback. The containerized Ollama (make services-start PROFILE=ollama or
# PROFILE=full) publishes on host port 11435, not 11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=sam860/LFM2:350m
# For OpenAI-compatible backends (LM Studio, llama.cpp, vLLM, Jan):
# When running the app in Docker (make services-start PROFILE=full), the server runs on your host
# machine, not in the container, so "localhost" here means the container itself and
# generation will fail with connection refused. Use host.docker.internal instead.
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_API_KEY=  # Optional, some servers don't require it
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# Optional overrides for the embedding model's encoding. Leave unset to use the model's own
# declared prompts (sentence-transformers `model.prompts`) and sequence length.
# EMBEDDING_QUERY_PROMPT=
# EMBEDDING_DOCUMENT_PROMPT=
# EMBEDDING_MAX_SEQ_LENGTH=
# Load precision: float32 (default), float16, or bfloat16. Halving precision halves the
# weight memory, which is what makes multi-billion-parameter embedders fit.
# EMBEDDING_DTYPE=
OLLAMA_NUM_CTX=8192

# Retriever the HTTP API serves search and answer requests from: 'bm25' (default) or 'hybrid'
# RETRIEVER=bm25

# Vector database settings (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
COLLECTION_NAME=documents

# Chat storage settings
CHAT_STORAGE_PATH=./data/chat_history.db

# Langfuse tracing (optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Application settings
LOG_LEVEL=INFO
